#compdef linear
#autoload

local -a _1st_arguments
_1st_arguments=(
  'new:create a new issue (optionally for a team)'
  'inbox:open your inbox'
  'mine:open my issues'
  'team:open a team'"'"'s issues'
  'search:search for issues'
  'branch:open the issue named after the git branch of the current directory'
  'dumpconfig:display effective linear configuration'
  'help:print usage help to stdout'
)

_arguments -C \
  ':command:->command' \
  '*::options:->options'

case $state in
  (command)
    _describe -t commands "linear subcommand" _1st_arguments
    return
   ;;
esac
